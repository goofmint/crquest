# ローカル Supabase 用の環境変数テンプレート。
# `.env.supabase.local` にコピーして使う（このファイルに実際の値を書かない）。
# 値の取得元: `npx supabase status -o env`
#   変数名を変えたい場合は `--override-name` を使う。
#   例: npx supabase status -o env --override-name api.url=SUPABASE_URL
# `supabase status` の出力には秘密情報が含まれる。共有やコミットをしない。

# ===== クライアント用 (アプリに渡してよい値) =====
# `VITE_` 接頭辞はここだけで使う。サーバー専用の値には付けない。
# API URL (status の API_URL)
SUPABASE_URL=
# publishable キー (旧名 ANON_KEY。RLS で守られる前提の公開キー)
SUPABASE_PUBLISHABLE_KEY=

# ===== サーバー専用 (クライアント・public/・Tauri リソースに置かない) =====
# secret キー (旧名 SERVICE_ROLE_KEY。RLS を迂回する)
SUPABASE_SECRET_KEY=
# DB 接続 URL (status の DB_URL)
SUPABASE_DB_URL=
# JWT 署名用シークレット (status の JWT_SECRET)
SUPABASE_JWT_SECRET=

# ===== ミッションカタログの発行 (`npm run sync:missions -- --target remote` 専用) =====
# 運用の資格情報。サーバーまたは CLI の環境変数 (または未コミットの .env) にだけ置く。
# VITE_ 接頭辞、public/、Tauri リソース、クライアントのビルドには絶対に置かない。
# --target local ではどちらも使わない (`supabase status` から取得する)。URL は https のみ。
TERMINALQUEST_CATALOG_SUPABASE_URL=
TERMINALQUEST_CATALOG_SUPABASE_SECRET_KEY=

# ===== OAuth ログイン (GitHub / Google) =====
# ローカル Supabase Auth が読む。値は各プロバイダーの OAuth アプリで作る (docs/supabase/auth.md)。
# 実際の値は `.env.supabase.local` にだけ書き、コミットしない。
# コールバック URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ===== アプリのビルド時設定 (Rust 側が読む。`option_env!`) =====
# URL を空にすると、デバッグビルドはローカルスタック (http://127.0.0.1:54321) を使う。
# リリースビルドは https の URL だけを受け付ける。未設定ならログインは無効 (ゲームは通常どおり動く)。
# publishable キーだけを入れる。secret / service_role キーは入れない。
TERMINALQUEST_SUPABASE_URL=
TERMINALQUEST_SUPABASE_PUBLISHABLE_KEY=
