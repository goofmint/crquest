{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TerminalQuest",
  "version": "../public/package.json",
  "identifier": "com.terminalquest.desktop",
  "build": {
    "frontendDist": "../tauri-dist",
    "beforeDevCommand": { "script": "npm run build:tauri", "wait": true },
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TerminalQuest",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 576,
        "backgroundColor": "#232323",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'unsafe-eval'"],
        "worker-src": ["'self'", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:"],
        "media-src": ["'self'", "asset:", "http://asset.localhost", "data:"],
        "font-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "https://www.youtube.com"
        ],
        "frame-src": ["https://www.youtube.com"]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$CONFIG/terminalquest/**",
          "$CONFIG/TerminalQuest/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["terminalquest"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/content/": "content/",
      "../public/levels/": "levels/",
      "../public/avatars/parts/": "avatars/parts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
