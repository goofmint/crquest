{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TerminalQuest",
  "version": "../public/package.json",
  "identifier": "com.terminalquest.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": { "script": "npm run build:tauri", "wait": true },
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TerminalQuest",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 576,
        "backgroundColor": "#232323"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$CONFIG/terminalquest/**",
          "$CONFIG/TerminalQuest/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/content/": "content/",
      "../public/levels/": "levels/",
      "../public/avatars/parts/": "avatars/parts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
