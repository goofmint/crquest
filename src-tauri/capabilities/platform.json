{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "platform",
  "description": "Least-privilege access for the platform layer (fs, dialog, store, opener, os). See docs/migration/tauri-platform.md",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "/proc/cpuinfo"
        },
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [
        {
          "path": "$RESOURCE"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-message",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-has",
    "store:allow-delete",
    "store:allow-save",
    "store:allow-reload",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/config.json"
        },
        {
          "path": "$CONFIG/terminalquest"
        },
        {
          "path": "$CONFIG/terminalquest/**"
        },
        {
          "path": "$CONFIG/TerminalQuest"
        },
        {
          "path": "$CONFIG/TerminalQuest/**"
        }
      ]
    },
    "os:allow-platform",
    {
      "identifier": "allow-run-command",
      "allow": [
        {
          "program": "git"
        },
        {
          "program": "node"
        },
        {
          "program": "npm"
        },
        {
          "program": "python"
        },
        {
          "program": "python3"
        },
        {
          "program": "python3.*"
        }
      ]
    },
    {
      "identifier": "allow-command-exists",
      "allow": [
        {
          "program": "git"
        },
        {
          "program": "node"
        },
        {
          "program": "npm"
        },
        {
          "program": "python"
        },
        {
          "program": "python3"
        },
        {
          "program": "python3.*"
        }
      ]
    },
    {
      "identifier": "allow-path-exists",
      "allow": [
        {
          "program": "git"
        },
        {
          "program": "node"
        },
        {
          "program": "npm"
        },
        {
          "program": "python"
        },
        {
          "program": "python3"
        },
        {
          "program": "python3.*"
        }
      ]
    },
    "allow-is-dev",
    "allow-open-devtools",
    "allow-toggle-devtools",
    "allow-enable-help-menu",
    "allow-set-shell-texts",
    "allow-auth-status",
    "allow-auth-start-login",
    "allow-auth-cancel-login",
    "allow-auth-logout",
    "allow-cloud-save-fetch",
    "allow-cloud-save-upload",
    "allow-unlock-code-redeem",
    "allow-tree-planting-record",
    "allow-live-events-list",
    "allow-live-events-ranking",
    "allow-live-events-team-ranking",
    "allow-live-events-join",
    "allow-live-events-update",
    "allow-live-events-status"
  ]
}
