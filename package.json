    "@vitejs/plugin-react": "^6.3.0",
    "assert": "^2.1.0",
    "command-line-args": "^6.0.2",
    "common-tags": "^1.8.2",
    "date-fns": "^4.4.0",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
