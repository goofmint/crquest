{
  "name": "terminalquest",
  "//aboutVersion": "See public/package.json for actual game/app version.",
  "version": "3.0.0-do-not-edit",
  "license": "MIT",
  "author": "TerminalQuest authors",
  "repository": "terminalquest/terminalquest",
  "main": "main.js",
  "scripts": {
    "start": "npm-run-all build:all -r --parallel launch watch:all",
    "ci": "npm-run-all install:app build:all release",
    "install:build": "npm install",
    "install:app": "cd ./public && npm install",
    "postinstall": "npm run install:app",
    "release": "node tasks/create_release.js",
    "check:platform": "node tasks/check_platform_boundary.js",
    "audit-items": "node tasks/audit_items.js",
    "generateVoiceOvers": "node tasks/generate_voice_overs/index.js",
    "scaffold:mission": "node tasks/scaffold/index.js",
    "sync:missions": "node tasks/sync_missions/index.js",
    "launch": "electron .",
    "clean": "node tasks/clean_build_output.js",
    "build": "npm run build:all",
    "build:all": "npm-run-all clean --parallel build:js build:css",
    "build:js": "vite build",
    "build:js:tauri": "vite build --mode tauri",
    "build:tauri": "npm-run-all clean --parallel build:js:tauri build:css",
    "build:css": "sass src/scss/main.scss public/index.css --no-source-map",
    "watch:all": "npm-run-all --parallel watch:js watch:css",
    "watch:js": "vite build --watch --sourcemap",
    "watch:css": "sass src/scss/main.scss public/index.css --no-source-map --watch",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "aws-sdk": "^2.640.0",
    "chalk": "^4.1.0",
    "cheerio": "^1.0.0-rc.3",
    "csv-writer": "^1.6.0",
    "dotenv": "^8.2.0",
    "electron": "^11.5.0",
    "electron-context-menu": "^0.16.0",
    "electron-devtools-installer": "^2.2.4",
    "firebase-admin": "^8.10.0",
    "fs-jetpack": "^2.2.3",
    "git-branch": "^2.0.1",
    "klaw": "^4.0.1",
    "md5-file": "^4.0.0",
    "modclean": "^3.0.0-beta.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.19.1",
    "pug": "^2.0.4",
    "sass": "^1.108.2",
    "tar": "^4.4.13",
    "through2": "^4.0.2"
  },
  "devDependencies": {
    "@actions/core": "^1.9.0",
    "@oxc-project/runtime": "^0.158.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "assert": "^2.1.0",
    "command-line-args": "^5.1.1",
    "common-tags": "^1.8.0",
    "date-fns": "^2.15.0",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "ncp": "^2.0.0",
    "npm": "^6.14.8",
    "path-browserify": "^1.0.1",
    "path-browserify-win32": "2.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "version-sort": "^0.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@11.5.0": true
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "^3.4.0"
    }
  }
}
