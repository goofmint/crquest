  "repository": "terminalquest/terminalquest",
  "scripts": {
    "start": "tauri dev",
    "ci": "npm-run-all install:app release",
    "install:build": "npm install",
    "install:app": "npm ci --prefix public",
    "postinstall": "npm run install:app",
    "release": "tauri build",
    "check:platform": "node tasks/check_platform_boundary.js",
    "audit-items": "node tasks/audit_items.js",
    "generateVoiceOvers": "node tasks/generate_voice_overs/index.js",
    "scaffold:mission": "node tasks/scaffold/index.js",
    "sync:missions": "node tasks/sync_missions/supabase.js",
    "sync:missions:firestore": "node tasks/sync_missions/index.js",
    "sync:unlock-codes": "node tasks/sync_unlock_codes/index.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:functions": "supabase functions serve",
    "supabase:smoke": "node tasks/supabase_smoke/index.js",
    "supabase:catalog-check": "node tasks/supabase_catalog_check/index.js",
    "clean": "node tasks/clean_build_output.js",
    "build": "npm run build:tauri",
    "build:js:tauri": "vite build --mode tauri",
    "build:tauri": "npm-run-all clean --parallel build:js:tauri build:css --serial stage:tauri",
    "stage:tauri": "node tasks/stage_tauri_frontend.js",
    "build:css": "sass src/scss/main.scss public/index.css --no-source-map",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
