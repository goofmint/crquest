    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^18.0.10",
    "firebase-admin": "^14.5.1",
    "fs-jetpack": "^5.1.0",
    "klaw": "^4.1.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^1.19.1",
    "pug": "^3.0.4",
    "sass": "^1.108.2",
    "through2": "^5.0.12"
  },
