-
  const STATE_KEY = 'TQ_API_ACADEMY_WORLD_STATE';
  const worldState = getState(STATE_KEY);
  const allComplete = worldState.insideCatacombs.keySpellsObtained.length === 4;
  const hasPledgeScroll = Object.hasOwn(worldState.insideCatacombs, "hasPledgeScroll") && worldState.insideCatacombs.hasPledgeScroll === true;

mixin gauntlet
  response#gauntlet.
    寮の試練とはどんなものですか？

conversation(display_name="秘術 API 学院の管理人")
  case lastResponse

    when "gauntlet"
      statement#gauntlet

    default
      statement#default
      responses
        +gauntlet

  statements

    statement#default
      if hasPledgeScroll
        text.
          盛り上がってきましたよ！ 寮の試練がまもなく始まるところです。大広間へまっすぐ進んでください。寮の儀式に向けて、寮の炎の準備をしているはずです。どの寮に入りたいか、もう考えましたか？

      else if allComplete
        text.
          解錠の呪文はそろっています。地下墓地の中央にある聖なる巻物の間で誓約書を受け取ってから、大広間へ向かってください。

      else
        text.
          またお会いしましたね、オペレーター！ 寮の試練はまもなく始まりますが、地下墓地の課題がまだ残っているようですね。すべて終えると、この道を大広間へ進み、寮を選べるようになります。

    statement#gauntlet
      text.
        寮の試練では、ラブレス塔、ホッパー温室、フォン・ノイマン研究室、チューリングの野原で高度な API 課題に挑みます。中庭を抜けた先の大広間から、どの場所にも行けます。ただし試練の間は、立ち入りできない場所もあります。

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
