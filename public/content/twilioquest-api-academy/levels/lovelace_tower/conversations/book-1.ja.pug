-
  const STATE_KEY = 'TQ_LOVELACE_TOWER_WORLD_STATE';
  const worldState = getState(STATE_KEY);

mixin excerpt
  response#excerpt.
    本文の抜粋

conversation(display_name="ラブレスの書　第 1 巻")
  case lastResponse

    when "excerpt"
      statement#excerpt

    default
      statement#default
      responses
        +excerpt

  statements
    statement#default
      text.
        <p style="text-align:center"><span class="highlight"><a href="https://sci-hub.ru/https://journals.sagepub.com/doi/abs/10.1177/0047281617721853">API ドキュメント<br><br>ソフトウェア開発者が求めるもの</a></span><br><br>
        Michael Meng、Stephanie Steinhardt、Andreas Schubert 著</p>

    statement#excerpt
      text.
        「API の設計に加え、API の使いやすさへの関心が高まるにつれ、ドキュメントへの関心も高まっている。利用者が課題を効果的かつ効率的に解決できるようにすることで、<span class="highlight">ドキュメントが使いやすさに大きく影響する</span>ためだ……」（2 ページ）

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
